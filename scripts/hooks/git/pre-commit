#!/usr/bin/env bash
# Lint and format-check what this commit holds, and format-check and test the
# Rust when it holds Rust. Only the staged files: other sessions' uncommitted work in the
# same checkout isn't this commit's to fail on. `npm run check` in CI covers
# the whole tree.
set -euo pipefail

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
[ ${#staged[@]} -eq 0 ] && exit 0

scripts=()
for file in "${staged[@]}"; do
  case "$file" in *.ts | *.tsx | *.js | *.mjs) scripts+=("$file") ;; esac
done

if [ ${#scripts[@]} -gt 0 ]; then
  npx eslint --no-warn-ignored -- "${scripts[@]}"
fi
npx prettier --check --ignore-unknown -- "${staged[@]}"

for file in "${staged[@]}"; do
  case "$file" in
    crates/* | src-tauri/* | Cargo.toml | Cargo.lock | rustfmt.toml)
      cargo fmt --all -- --check
      cargo test --quiet -p rove-core
      break
      ;;
  esac
done
