{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit", "^build"]
    },
    "test": {
      "dependsOn": ["transit", "^build"],
      "outputs": []
    },
    "@swiftsolve/rove-ui#typecheck": {
      "dependsOn": ["transit", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/rove/src/**"]
    },
    "@swiftsolve/rove-ui#test": {
      "dependsOn": ["transit", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/rove/src/**"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["transit", "^build"],
      "outputs": ["dist/**"]
    },
    "@swiftsolve/rove-tokens#build": {
      "outputs": ["dist/**", "DESIGN.md"]
    },
    "@swiftsolve/rove-tokens#test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "build:storybook": {
      "dependsOn": ["transit", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/rove/src/**"],
      "outputs": ["storybook-static/**"]
    },
    "//#eslint": {
      "inputs": [
        "**/*.{ts,tsx,js,mjs,cjs,json}",
        "pnpm-lock.yaml",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!.git/**",
        "!.turbo/**",
        "!.claude/**",
        "!target/**",
        "!apps/rove/src-tauri/**",
        "!crates/**"
      ],
      "outputs": []
    },
    "//#typecheck:scripts": {
      "inputs": ["scripts/**/*.{ts,json}", "apps/rove/src/**", "pnpm-lock.yaml"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
