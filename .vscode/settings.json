{
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "tailwindCSS.classFunctions": ["cva", "cx", "cn"],
  "cssVariables.lookupFiles": [
    "src/**/*.css",
    "node_modules/@swiftsolve/rove-tokens/dist/tokens.css",
    "node_modules/@swiftsolve/rove-tokens/dist/text-styles.css"
  ],
  "cssVariables.blacklistFolders": ["**/.git"],
  "cssVariables.languages": ["css", "tailwindcss", "javascriptreact", "typescriptreact"],
  "files.watcherExclude": {
    "**/.claude/worktrees/**": true
  },
  "search.exclude": {
    "**/.claude/worktrees": true
  },
  "explorer.sortOrder": "mixed",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, .nvmrc, chromatic.config.json",
    "Cargo.toml": "Cargo.lock",
    "vite.config.ts": "vitest.config.ts, tsconfig.json",
    "eslint.config.js": ".prettierrc.json, .prettierignore",
    ".gitignore": ".git-blame-ignore-revs",
    "README.md": "AGENTS.md, THIRD-PARTY-NOTICES.md"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.tsserver.watchOptions": {
    "excludeDirectories": ["**/.claude/worktrees"]
  }
}
