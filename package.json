{
  "name": "rove-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "dev": "pnpm --filter rove dev",
    "build:web": "turbo run build --filter=rove",
    "lint": "turbo run eslint && prettier --check --cache --cache-strategy content . && node scripts/checks/run.ts",
    "eslint": "eslint .",
    "format": "prettier --write .",
    "gen": "node scripts/gen/components.ts && node scripts/gen/cn-theme.ts",
    "figma:export": "node scripts/checks/figma-export.ts --export",
    "typecheck": "turbo run typecheck typecheck:scripts",
    "typecheck:scripts": "tsc -p scripts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "screenshots": "node scripts/screenshots.ts",
    "diagrams": "node scripts/gen/docs-diagrams.ts",
    "tokens": "pnpm --filter @swiftsolve/rove-tokens",
    "storybook": "pnpm --filter @swiftsolve/rove-ui storybook",
    "build:storybook": "pnpm --filter @swiftsolve/rove-ui build:storybook",
    "chromatic": "pnpm --filter @swiftsolve/rove-ui chromatic",
    "a11y": "node scripts/a11y-audit.ts",
    "tauri": "pnpm --filter rove tauri",
    "tauri:dev": "pnpm --filter rove tauri:dev",
    "tauri:build": "pnpm --filter rove tauri:build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "prepare": "git config core.hooksPath scripts/hooks/git || true"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@swiftsolve/rove-ui": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/estree": "^1.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "^8.20.0",
    "axe-core": "^4.10.2",
    "chromatic": "^18.13.6",
    "eslint": "^10.7.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-docgen-typescript": "^2.4.0",
    "storybook": "^10.6.5",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.12"
  }
}
