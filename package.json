{
  "name": "rove",
  "version": "0.0.3",
  "description": "Rove — a desktop app for Wi-Fi and Ethernet network monitoring",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build:web": "tsc && vite build",
    "lint": "eslint . && node scripts/check-css-modules.mjs && node scripts/check-cn-theme.mjs && node scripts/check-raw-values.mjs && node scripts/check-file-names.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "screenshots": "node scripts/screenshots.mjs",
    "a11y": "node scripts/a11y-audit.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@swiftsolve/rove-design": "^6.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.105.0",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "ldrs": "^1.1.9",
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.10.2",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.12"
  }
}
