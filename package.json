{
  "name": "rove-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w rove",
    "build:web": "turbo run build --filter=rove",
    "lint": "eslint . && prettier --check . && node scripts/checks/run.ts",
    "format": "prettier --write .",
    "gen": "node scripts/gen/components.ts && node scripts/gen/cn-theme.ts",
    "figma:export": "node scripts/checks/figma-export.ts --export",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "check": "npm run typecheck && npm run lint && npm test",
    "screenshots": "node scripts/screenshots.ts",
    "storybook": "npm run storybook -w @swiftsolve/rove-ui",
    "build:storybook": "npm run build:storybook -w @swiftsolve/rove-ui --",
    "chromatic": "npm run chromatic -w @swiftsolve/rove-ui",
    "a11y": "node scripts/a11y-audit.ts",
    "tauri": "npm run tauri -w rove --",
    "tauri:dev": "npm run tauri:dev -w rove",
    "tauri:build": "npm run tauri:build -w rove",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "prepare": "git config core.hooksPath scripts/hooks/git || true"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "^8.20.0",
    "axe-core": "^4.10.2",
    "chromatic": "^18.13.6",
    "eslint": "^10.7.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.5",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
