{
  "name": "rove",
  "version": "0.0.3",
  "description": "Rove — a desktop app for Wi-Fi and Ethernet network monitoring",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build:web": "tsc && vite build",
    "lint": "eslint . && node scripts/check-css-modules.mjs && node scripts/check-cn-theme.mjs && node scripts/check-raw-values.mjs && node scripts/check-ui-classname.mjs && node scripts/check-file-names.mjs && node scripts/build-ui-catalogue.mjs --check",
    "catalogue": "node scripts/build-ui-catalogue.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "screenshots": "node scripts/screenshots.mjs",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "chromatic": "chromatic",
    "a11y": "node scripts/a11y-audit.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@swiftsolve/rove-design": "^3.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.105.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "ldrs": "^1.1.9",
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "^4.10.2",
    "chromatic": "^18.13.6",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "playwright-core": "^1.61.1",
    "storybook": "^10.6.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
