{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": ["Edit(**/*.gen.*)", "Edit(**/catalog/figma/**)", "Edit(packages/tokens/src/figma/**)", "Edit(**/dist/**)", "Edit(**/storybook-static/**)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/claude/guard-bash.ts\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/claude/lint-edited-file.ts\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
